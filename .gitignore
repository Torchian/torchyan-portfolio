# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: `/node_modules` only matched the repo root, which is how a nested
# torchyan-portfolio/node_modules once got committed.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Claude Code session state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# large assets (use CDN or compress before committing)
public/vectors/background.png

# originals kept by scripts/optimize-images.ts
.originals/
