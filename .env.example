# Copy to .env.local and fill in. Everything here is optional in development:
# each variable falls back to a safe default, listed per entry.

# The site's own origin, no trailing slash. Canonical URLs, hreflang, the sitemap,
# robots.txt and the Open Graph URLs are all built from it, so a wrong value here
# points search engines and social previews at the wrong host.
# Default: https://torchyan.design
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Leave blank to load no GA script at all.
# Default: blank (disabled)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Yandex Metrica counter ID. Leave blank to load no Yandex script at all.
# Webvisor records sessions, including typing in the contact form — see the
# analytics consent item in TODO.md before enabling this in production.
# Default: blank (disabled)
NEXT_PUBLIC_YM_COUNTER_ID=

# Development only: force the country used for locale detection, as an ISO 3166-1
# alpha-2 code (RU, AM, US, ...). Ignored outside development, where the country
# comes from the host's own header instead (see src/i18n/detection.ts).
# Default: unset (fall back to the browser language)
DEV_COUNTRY=

# ── Contact form ────────────────────────────────────────────────────────────
# All three are required for the form to send. Without them the endpoint
# answers 503 and the form shows its error state, rather than quietly
# swallowing a message. See docs/setup/domain-email-hosting.md.

# Resend API key, from resend.com → API Keys. Starts with `re_`.
# This is a secret: set it on the host, never commit it.
RESEND_API_KEY=

# Who the mail comes from. Must be on a domain verified in Resend, and the
# mailbox need not exist — nobody replies to it.
CONTACT_FROM=Torchyan Portfolio <noreply@torchyan.design>

# Where the mail lands: your real inbox. The sender's address goes in Reply-To,
# so replying in your mail client answers them.
CONTACT_TO=

# ── Maintenance mode ────────────────────────────────────────────────────────
# Set this to any phrase and the whole site answers a holding page instead,
# except to a visitor who has entered that phrase — at /?unlock=<phrase>, or
# through the form on the holding page. The choice is kept in a cookie for a
# month. Leave it blank or remove it and the site is open again; on a host,
# either change takes a redeploy.
#
# It keeps a site that is still being built away from visitors and out of
# search results (the holding page answers 503 and noindex). It is not
# authentication: anyone with the phrase sees everything you see.
MAINTENANCE_PASSPHRASE=
