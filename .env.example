# Copy to .env.local and fill in. Everything here is optional in development:
# each variable falls back to a safe default, listed per entry.

# The site's own origin, no trailing slash. Canonical URLs, hreflang, the sitemap,
# robots.txt and the Open Graph URLs are all built from it, so a wrong value here
# points search engines and social previews at the wrong host.
# Default: https://torchyan.design
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Leave blank to load no GA script at all.
# Default: blank (disabled)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Yandex Metrica counter ID. Leave blank to load no Yandex script at all.
# Webvisor records sessions, including typing in the contact form — see the
# analytics consent item in TODO.md before enabling this in production.
# Default: blank (disabled)
NEXT_PUBLIC_YM_COUNTER_ID=

# Development only: force the country used for locale detection, as an ISO 3166-1
# alpha-2 code (RU, AM, US, ...). Ignored outside development, where the country
# comes from the host's own header instead (see src/i18n/detection.ts).
# Default: unset (fall back to the browser language)
DEV_COUNTRY=
